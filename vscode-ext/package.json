{
  "name": "foreman",
  "displayName": "Foreman",
  "description": "Google Docs for coding agents: live function locks, agent cursors and handoffs in your editor.",
  "publisher": "foreman",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "foreman.createRoom",
        "title": "Foreman: Start a room"
      },
      {
        "command": "foreman.joinRoom",
        "title": "Foreman: Join room"
      },
      {
        "command": "foreman.leaveRoom",
        "title": "Foreman: Leave room"
      },
      {
        "command": "foreman.copyInvite",
        "title": "Foreman: Copy room code"
      },
      {
        "command": "foreman.revoke",
        "title": "Revoke lock"
      },
      {
        "command": "foreman.pullCommit",
        "title": "Foreman: Pull handed-off commit"
      },
      {
        "command": "foreman.reload",
        "title": "Foreman: Update (git pull) and reload"
      },
      {
        "command": "foreman.inviteTeammate",
        "title": "Foreman: Invite teammate",
        "icon": "$(person-add)"
      },
      {
        "command": "foreman.reviewRequest",
        "title": "Foreman: Review join request"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "foreman",
          "title": "Foreman",
          "icon": "media/foreman.svg"
        }
      ]
    },
    "views": {
      "foreman": [
        {
          "id": "foreman.room",
          "name": "Room"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "foreman.room",
        "contents": "Code together with your teammates' agents: live function locks, handoffs and caller warnings.\n[Start a room](command:foreman.createRoom)\nSign in with GitHub, pick a colour, and get a short code to send your teammate.\n[Join a room](command:foreman.joinRoom)\nSign in with GitHub and enter the code your teammate sent."
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "foreman.revoke",
          "when": "view == foreman.room && viewItem == lock"
        }
      ],
      "view/title": [
        {
          "command": "foreman.inviteTeammate",
          "when": "view == foreman.room",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Foreman",
      "properties": {
        "foreman.serverUrl": {
          "type": "string",
          "default": "https://foreman.rishikhesh.com",
          "description": "The Foreman server everyone in your team connects to."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Live view works everywhere; Create/Join room run the Foreman CLI and need a trusted folder."
    }
  }
}